# ---------- قاعدة البيانات والمصادقة (Vercel Postgres / Neon) ----------
# يُضاف تلقائياً عند ربط قاعدة بيانات من Vercel > Storage
DATABASE_URL=
# سر توقيع جلسات الدخول (نص عشوائي طويل)
AUTH_SECRET=

# ---------- النموذج اللغوي ----------
# أحد الخيارات: openai-compatible | anthropic | oracle | none
LLM_PROVIDER=none

# openai-compatible (أي نقطة نهاية متوافقة مع OpenAI Chat Completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# anthropic
ANTHROPIC_API_KEY=

# oracle (يُضبط بعد معاينة واجهة النموذج لديك)
ORACLE_LLM_URL=
ORACLE_LLM_KEY=
ORACLE_LLM_MODEL=
